# Copier en `.env` à côté de docker-compose.yml et remplir chaque valeur.

# Mots de passe des rôles Postgres, lus par le script d'initialisation au premier démarrage.
POSTGRES_PASSWORD=
CHAT_DB_PASSWORD=
ELECTRIC_DB_PASSWORD=

# Secret partagé entre l'application et Electric ; jamais envoyé au navigateur.
ELECTRIC_SECRET=

# Signature des cookies de session : au moins 32 caractères.
WICA_SESSION_SECRET=
# Clé d'instance qui chiffre les jetons de modèle : 32 octets en base64 (`openssl rand -base64 32`).
WICA_INSTANCE_KEY=

# Domaine servi par Caddy en HTTPS. Un vrai domaine obtient un certificat public, ses ports 80 et
# 443 joignables depuis Internet ; `localhost` utilise l'autorité locale de Caddy, que le navigateur
# ne connaît pas tant qu'on ne l'a pas installée.
WICA_DOMAIN=localhost
# Ports publiés par Caddy ; un certificat public demande 80 et 443.
WICA_HTTP_PORT=80
WICA_HTTPS_PORT=443

# Mode d'identité : bootstrap, oidc ou proxy.
WICA_AUTH=bootstrap
# Mode bootstrap : jeton d'administration qui crée les comptes par `POST /api/admin/users`.
WICA_ADMIN_TOKEN=

# Modèle par défaut, servi par Open Responses (wic-serving). Les deux vont ensemble.
WICA_MODEL_URL=
WICA_MODEL=
WICA_API_KEY=

# 1 : propose aussi les faux modèles « Lorem ipsum », qui répondent du texte écrit à l'avance
# sans appeler de vrai modèle. Pour essayer le chat ; vide sur une vraie instance.
WICA_TEST_MODELS=

# Mode oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ORGS_CLAIM=
OIDC_ROLES_CLAIM=

# Mode proxy : en-têtes posés par le proxy, et adresses depuis lesquelles ils sont crus. Le proxy
# d'authentification joint Caddy ; ses adresses sont celles que Caddy voit.
PROXY_USER_HEADER=
PROXY_NAME_HEADER=
PROXY_GROUPS_HEADER=
PROXY_ADDRESSES=
