# Copy to `.env` next to docker-compose.yml and fill in every value.

# Passwords of the Postgres roles, read by the initialization script on first start.
POSTGRES_PASSWORD=
CHAT_DB_PASSWORD=
ELECTRIC_DB_PASSWORD=

# Secret shared between the application and Electric; never sent to the browser.
ELECTRIC_SECRET=

# Session cookie signing: at least 32 characters.
WICA_SESSION_SECRET=
# Instance key that encrypts model tokens: 32 bytes in base64 (`openssl rand -base64 32`).
WICA_INSTANCE_KEY=

# Domain served by Caddy over HTTPS. A real domain gets a public certificate, with its ports 80 and
# 443 reachable from the Internet; `localhost` uses Caddy's local authority, which the browser
# does not know until it is installed.
WICA_DOMAIN=localhost
# Ports published by Caddy; a public certificate needs 80 and 443.
WICA_HTTP_PORT=80
WICA_HTTPS_PORT=443

# Identity mode: bootstrap, oidc or proxy.
WICA_AUTH=bootstrap
# Bootstrap mode: administration token that creates accounts through `POST /api/admin/users`.
WICA_ADMIN_TOKEN=

# Default model, served by Open Responses (wic-serving). The two go together.
WICA_MODEL_URL=
WICA_MODEL=
WICA_API_KEY=

# 1: also offers the fake "Lorem ipsum" models, which answer with text written in advance
# without calling a real model. For trying the chat; empty on a real instance.
WICA_TEST_MODELS=

# Mode oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ORGS_CLAIM=
OIDC_ROLES_CLAIM=

# Proxy mode: headers set by the proxy, and the addresses from which they are trusted. The
# authentication proxy reaches Caddy; its addresses are the ones Caddy sees.
PROXY_USER_HEADER=
PROXY_NAME_HEADER=
PROXY_GROUPS_HEADER=
PROXY_ADDRESSES=
