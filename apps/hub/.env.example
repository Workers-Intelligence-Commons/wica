# Copy to `.env` next to docker-compose.yml and fill in every value.

# Passwords of the Postgres roles, read by the initialization script on first start.
POSTGRES_PASSWORD=
CHAT_DB_PASSWORD=
ELECTRIC_DB_PASSWORD=

# Secret shared between the application and Electric; never sent to the browser.
ELECTRIC_SECRET=

# Session cookie signing: at least 32 characters.
WICA_SESSION_SECRET=
# Instance key that encrypts model tokens: 32 bytes in base64 (`openssl rand -base64 32`).
WICA_INSTANCE_KEY=

# Domain served by Caddy over HTTPS. A real domain gets a public certificate, with its ports 80 and
# 443 reachable from the Internet; `localhost` uses Caddy's local authority, which the browser
# does not know until it is installed.
WICA_DOMAIN=localhost
# Ports published by Caddy; a public certificate needs 80 and 443.
WICA_HTTP_PORT=80
WICA_HTTPS_PORT=443

# Identity mode: accounts or oidc. `accounts`: the hub keeps the accounts, with email and
# password, and anyone who reaches the instance may create one.
WICA_AUTH=accounts
# Token of the administration API.
WICA_ADMIN_TOKEN=

# Default model, served by Open Responses (wic-serving). The two go together.
WICA_MODEL_URL=
WICA_MODEL=
WICA_API_KEY=

# 1: also offers the fake "Lorem ipsum" models, which answer with text written in advance
# without calling a real model. For trying the hub; empty on a real instance.
WICA_TEST_MODELS=

# 1: people without an account may talk to the default model (WICA_MODEL), once they agree to
# the fingerprint of their browser that counts their messages; WICA_GUEST_DAILY_LIMIT messages a
# day each, 20 when empty.
WICA_GUESTS=
WICA_GUEST_DAILY_LIMIT=

# Sites whose pages may hold the guest chat component, as origins separated by commas
# (https://asso.example,https://www.asso.example); needs WICA_GUESTS. A listed site adds:
#   <script type="module" src="https://<this hub>/embed/wic-guest-chat.js"></script>
#   <wic-guest-chat></wic-guest-chat>
WICA_EMBED_ORIGINS=

# Mode oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ORGS_CLAIM=
OIDC_ROLES_CLAIM=

